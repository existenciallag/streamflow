/**
 * StreamFlow – Dashboard Metrics
 *
 * Recreates the Python dashboard_metrics.py logic using spreadsheet data.
 * All functions read from the named sheets imported from the CSV export.
 */

// ─── HELPERS ──────────────────────────────────────────────────────────────────

/** Return all data from a sheet as an array of plain objects (header row → keys). */


// ══════════════════════════════════════════════════════════════════════════════
//  🚀 MAIN INSTALLER FUNCTION - Click Run → installStreamFlow
// ══════════════════════════════════════════════════════════════════════════════

function installStreamFlow(){const ui=SpreadsheetApp.getUi();if(ui.alert('🔬 StreamFlow Installer','Install with all data?\n✅ 116 reagents\n✅ 35 panels\n✅ 145 units\n⏱️ Takes 60 sec',ui.ButtonSet.YES_NO)!==ui.Button.YES)return;const toast=m=>SpreadsheetApp.getActiveSpreadsheet().toast(m,'Installing',5);try{toast('Creating sheets...');createAllSheets();toast('Importing data...');importAllData();toast('Formatting...');formatSheets();toast('Building dashboard...');buildDashboard();onOpen();ui.alert('✅ Done!','StreamFlow ready! Check Dashboard.',ui.ButtonSet.OK);SpreadsheetApp.getActiveSpreadsheet().setActiveSheet(SpreadsheetApp.getActiveSpreadsheet().getSheetByName('📊 Dashboard'))}catch(e){ui.alert('Error',e.toString(),ui.ButtonSet.OK)}}

function createAllSheets(){const ss=SpreadsheetApp.getActiveSpreadsheet();['📊 Dashboard','reagents','reagent_units','reagents_units','panels','panel_reagents','panel_areas','panel_disease_categories','panel_versions','panel_status_history','panel_general_reagents','general_reagents','general_reagent_units','general_reagents_units','brands','fluorochromes','cytometers','cytometer_optical_channels','optical_channels','acquisition_protocols','compensation_protocols','analysis_protocols','purchase_orders','purchase_order_items','reagent_unit_history'].forEach(n=>{if(!ss.getSheetByName(n))ss.insertSheet(n)});const s1=ss.getSheetByName('Sheet1');if(s1&&s1.getLastRow()===0)ss.deleteSheet(s1)}

function importAllData(){const ss=SpreadsheetApp.getActiveSpreadsheet();Object.keys(EMBEDDED_CSV_DATA).forEach(t=>{const s=ss.getSheetByName(t);if(!s)return;s.clearContents();const r=Utilities.parseCsv(EMBEDDED_CSV_DATA[t]);if(r.length===0)return;s.getRange(1,1,r.length,r[0].length).setValues(r);s.setFrozenRows(1);s.getRange(1,1,1,r[0].length).setFontWeight('bold').setBackground('#1565C0').setFontColor('#FFF')})}

function formatSheets(){SpreadsheetApp.getActiveSpreadsheet().getSheets().forEach(s=>{if(s.getName()==='📊 Dashboard')return;const lr=s.getLastRow(),lc=s.getLastColumn();if(lr<2)return;for(let r=2;r<=Math.min(lr,500);r++)s.getRange(r,1,1,lc).setBackground(r%2===0?'#F5F5F5':'#FFF');for(let c=1;c<=Math.min(lc,20);c++)s.autoResizeColumn(c)})}

function buildDashboard(){const ss=SpreadsheetApp.getActiveSpreadsheet();let d=ss.getSheetByName('📊 Dashboard');if(!d)d=ss.insertSheet('📊 Dashboard',0);d.clearContents();d.setColumnWidths(1,6,160);d.getRange('A1:F1').merge().setValue('🔬 StreamFlow Lab Manager').setFontSize(18).setFontWeight('bold').setFontColor('#0D47A1').setHorizontalAlignment('center');d.getRange('A2:F2').merge().setValue('Flow Cytometry Lab • Updated: '+new Date().toLocaleString()).setFontSize(10).setFontColor('#777').setHorizontalAlignment('center');let r=4;d.getRange(r,1,1,6).merge().setValue('📊 Quick Stats').setFontSize(14).setFontWeight('bold').setBackground('#1565C0').setFontColor('#FFF');r++;const cnt=n=>{const s=ss.getSheetByName(n);return s?Math.max(0,s.getLastRow()-1):0};[[' Reagents:',cnt('reagents')],[' Units:',cnt('reagent_units')],[' Panels:',cnt('panels')],[' Brands:',cnt('brands')]].forEach(s=>{d.getRange(r,1,1,2).setValues([[s[0],s[1]]]);r++});r++;d.getRange(r,1,1,6).merge().setValue('💡 Quick Start').setFontSize(14).setFontWeight('bold').setBackground('#37474F').setFontColor('#FFF');r++;['Use StreamFlow menu above','Check "reagents" sheet for antibodies','Check "panels" sheet for panels','Try: =SF_EXPIRY_ALERT("2025-06-01")','Try: =SF_REAGENT_NAME(id)'].forEach(t=>{d.getRange(r,1,1,6).merge().setValue(t);r++})}

function onOpen(){SpreadsheetApp.getUi().createMenu('🔬 StreamFlow').addItem('📊 Dashboard','goToDashboard').addItem('📋 Reagents','goToReagents').addItem('🧬 Panels','goToPanels').addSeparator().addItem('ℹ️ About','showAbout').addItem('🔄 Reinstall','installStreamFlow').addToUi()}

function goToDashboard(){SpreadsheetApp.getActiveSpreadsheet().setActiveSheet(SpreadsheetApp.getActiveSpreadsheet().getSheetByName('📊 Dashboard'))}
function goToReagents(){SpreadsheetApp.getActiveSpreadsheet().setActiveSheet(SpreadsheetApp.getActiveSpreadsheet().getSheetByName('reagents'))}
function goToPanels(){SpreadsheetApp.getActiveSpreadsheet().setActiveSheet(SpreadsheetApp.getActiveSpreadsheet().getSheetByName('panels'))}
function showAbout(){SpreadsheetApp.getUi().alert('🔬 StreamFlow','Flow Cytometry Lab Manager\n\n116 reagents • 35 panels • 145 units\n\nUse the menu for features!',SpreadsheetApp.getUi().ButtonSet.OK)}

function getSheetData(n){const ss=SpreadsheetApp.getActiveSpreadsheet(),s=ss.getSheetByName(n);if(!s||s.getLastRow()<2)return[];const[h,...r]=s.getDataRange().getValues();return r.map(row=>{const o={};h.forEach((h,i)=>o[h]=row[i]);return o})}
function today(){const d=new Date();d.setHours(0,0,0,0);return d}
function parseDate(v){if(!v)return null;const d=new Date(v);return isNaN(d.getTime())?null:d}

// ══════════════════════════════════════════════════════════════════════════════
//  📐 CUSTOM FUNCTIONS (use in cells)
// ══════════════════════════════════════════════════════════════════════════════

/** @customfunction */
function SF_DAYS_TO_EXPIRY(d){if(!d)return'';const e=new Date(d);if(isNaN(e.getTime()))return'INVALID';return Math.round((e-today())/86400000)}

/** @customfunction */
function SF_EXPIRY_ALERT(d){if(!d)return'';const days=SF_DAYS_TO_EXPIRY(d);if(typeof days!=='number')return days;if(days<0)return'🔴 EXPIRED';if(days<=7)return'🟠 '+days+'d';if(days<=30)return'🟡 '+days+'d';return'🟢 OK'}

/** @customfunction */
function SF_REAGENT_UNITS_AVAILABLE(id){if(!id)return 0;const u=getSheetData('reagent_units'),n=today();return u.filter(u=>u.reagent_id===id&&['stored','in use'].includes((u.status||'').toLowerCase())&&(!parseDate(u.expiration_date)||parseDate(u.expiration_date)>n)).length}

/** @customfunction */
function SF_REAGENT_NAME(id){if(!id)return'';const r=getSheetData('reagents').find(r=>r.id===id);return r?r.name:'Not found'}

/** @customfunction */
function SF_PANEL_NAME(id){if(!id)return'';const p=getSheetData('panels').find(p=>p.id===id);return p?p.name:'Not found'}

